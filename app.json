{
  "expo": {
    "name": "ProdyAI",
    "slug": "prodyai",
    "version": "1.0.0",
    "updates": {
      "enabled": false
    },
    "scheme": "acme",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      "expo-router",
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {}
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.masoom1970.ProdyAI"
    },
    "android": {
      "package": "com.masoom1970.ProdyAI"
    }
  }
}
